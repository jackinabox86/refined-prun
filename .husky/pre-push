z40=0000000000000000000000000000000000000000
files=""
full=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$z40" ] && continue
  if [ "$remote_sha" = "$z40" ]; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || base=""
    [ -n "$base" ] || { full=1; continue; }
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  files="$files
$(git diff --name-only --diff-filter=d "$range" -- '*.js' '*.jsx' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.mts' '*.cts' '*.vue')"
done

if [ "$full" = 1 ]; then
  pnpm lint
else
  files=$(printf '%s\n' "$files" | sed '/^$/d' | sort -u)
  if [ -n "$files" ]; then
    printf '%s\n' "$files" | xargs pnpm exec eslint --no-warn-ignored
  fi
fi
