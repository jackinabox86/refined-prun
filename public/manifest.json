{
  "name": "OOG RPrUn Test Fork",
  "version": "0.0.0",
  "description": "OOG Fork of Refined-Prun with custom additions not yet available on the base extension",
  "manifest_version": 3,
  "minimum_chrome_version": "107",
  "browser_specific_settings": {
    "gecko": {
      "id": "{cea48e52-981d-47bb-b859-bfec6a59fcae}",
      "strict_min_version": "140.0",
      "update_url": "https://storage.googleapis.com/oog-fork-gcs-bucket/updates.json",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["searchTerms", "personallyIdentifyingInfo"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://apex.prosperousuniverse.com/"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://apex.prosperousuniverse.com/*"
      ],
      "js": [
        "refined-prun-prepare.js",
        "refined-prun-startup.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.js",
        "*.css",
        "*.svg",
        "*.png",
        "*.gif",
        "*.json",
        "*.woff2",
        "*.ttf"
      ],
      "matches": [
        "https://apex.prosperousuniverse.com/*"
      ]
    }
  ]
}
