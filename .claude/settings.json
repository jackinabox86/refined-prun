{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/*)",
      "Bash(sleep *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(printf *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(curl *)",
      "Bash(pnpm *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(pnpm exec eslint *)",
      "Bash(tasklist *)",
      "Bash(node .local/scratch/*)",
      "Bash(python3 -c *)",
      "Bash(python3 /tmp/claude-1000/*)",
      "Bash(python3 .local/scratch/*)",
      "Bash(pgrep *)",
      "Bash(grok --no-auto-update --no-alt-screen --always-approve -p *)",
      "Bash(git merge-base *)",
      "Edit",
      "Agent",
      "SendMessage",
      "ToolSearch",
      "Skill",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop"
    ]
  },
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": ["api.x.ai", "auth.x.ai"]
    },
    "excludedCommands": [
      "node scripts/local-browser-test.mjs",
      "node scripts/pw-act.mjs *",
      "node scripts/pw-close.mjs",
      "node scripts/pw-kill.mjs",
      "node scripts/pw-screenshot.mjs *",
      "node .local/scratch/*",
      "sleep *",
      "pgrep *",
      "curl *"
    ]
  }
}
